# Local PostgreSQL URL when running the backend outside Docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intervai?schema=public

# Replace these with different long, random secrets (at least 16 characters).
JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-token-secret

# Frontend origin(s); CORS_ORIGINS supports comma-separated origins.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Keep this key private. Never expose it in frontend Vite variables.
GEMINI_API_KEY=your-gemini-api-key

PORT=3000
NODE_ENV=development
